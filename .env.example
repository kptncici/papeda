# Salin file ini menjadi .env.local lalu isi dari Supabase > Project Settings > API.
# Hanya dua nilai ini yang boleh ada di frontend. JANGAN menaruh service role key di sini.
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=isi-dengan-anon-public-key

# Opsional. Ubah ke true setelah Edge Functions di-deploy (lihat README).
VITE_ENABLE_EDGE_FUNCTIONS=false
